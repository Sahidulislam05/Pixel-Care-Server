# Copy this file to .env and fill in every value. Never commit .env.

# ---- Server ----
NODE_ENV=development            # "production" on Render
PORT=5000
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000   # exact frontend origin, used for CORS + payment redirects

# ---- Database (PostgreSQL with the pgvector extension) ----
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public"

# ---- Auth ----
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Google Cloud Console -> Credentials -> OAuth 2.0 Client ID (Web)
GOOGLE_CLIENT_ID=

# ---- Accounts seeded on startup ----
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

TESTER_ADMIN_NAME=Demo Admin
TESTER_ADMIN_EMAIL=
TESTER_ADMIN_PASSWORD=

TESTER_DOCTOR_NAME=Demo Doctor
TESTER_DOCTOR_EMAIL=
TESTER_DOCTOR_PASSWORD=

TESTER_PATIENT_NAME=Demo Patient
TESTER_PATIENT_EMAIL=patient.demo@pixelcare.test
TESTER_PATIENT_PASSWORD=

# ---- Redis (OTP, chat history, bKash token cache) ----
REDIS_USER=default
REDIS_PASSWORD=
REDIS_HOST=
REDIS_PORT=

# ---- Email (Gmail + App Password) ----
SMTP_USER=                       # your Gmail address
SMTP_PASSWORD=                   # 16-char Google App Password
EMAIL_SENDER=                    # e.g. "Pixel-care <you@gmail.com>"

# ---- Cloudinary (images, resumes, prescriptions) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- bKash tokenized checkout ----
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_APP_KEY=
BKASH_APP_SECRET=
# API base incl. /api/v1 — the code appends /appointment/book-appointment/payment/callback
BKASH_CALLBACK_URL=http://localhost:5000/api/v1

# ---- RAG chatbot (OpenRouter) ----
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=           # e.g. openai/gpt-4o-mini
OPENROUTER_FALLBACK_CHAT_MODELS= # optional, comma separated
OPENROUTER_EMBEDDING_MODEL=      # e.g. openai/text-embedding-3-small
